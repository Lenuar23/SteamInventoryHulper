{
  "manifest_version": 3,
  "name": "SIH Beta",
  "version": "1.2.1",
  "description": "Dota 2 inventory prices, gem color previews, and native price sorting and gem filtering.",
  "permissions": ["tabs"],
  "host_permissions": ["https://steamprice.com/*", "*://steamcommunity.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["*://steamcommunity.com/profiles/*/inventory*", "*://steamcommunity.com/id/*/inventory*"],
      "js": ["gems.js", "inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://steamcommunity.com/profiles/*/inventory*", "*://steamcommunity.com/id/*/inventory*"],
      "js": ["gems.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
